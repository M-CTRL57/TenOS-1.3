rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidUserPreferences(data) {
       return data.keys().hasOnly(['wallpaper', 'lockScreenWallpaper', 'themeColor']) &&
              (data.get('wallpaper', '') is string) &&
              (data.get('lockScreenWallpaper', '') is string) &&
              (data.get('themeColor', '') is string);
    }
    
    match /preferences/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUserPreferences(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUserPreferences(incoming());
      allow delete: if false;
    }
  }
}
